# 이 파일은 '양식'입니다. 실제 값은 .env 에만 넣으세요(.env 는 git 에 안 올라감).
# 복사: cp .env.example .env  → .env 를 채워서 사용

# ── 데이터 수집(아리수) ──────────────────────────────────────────
ARISU_USER_ID=your_id_here
ARISU_USER_PWD=your_password_here

# ── 에이전트(OpenAI GPT) ─────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.5

# ── 이상 알림 메일(Gmail SMTP) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com      # 발송 계정(앱 비밀번호 발급한 그 계정)
SMTP_PASS=your_gmail_app_password   # Gmail '앱 비밀번호' (일반 비번 아님)
ALERT_FROM=your_gmail@gmail.com     # 보통 SMTP_USER 와 동일
ALERT_TO=receiver@example.com       # 받는사람, 콤마로 다중 수신 가능

# ── 데모 기준일(선택) ────────────────────────────────────────────
# 비우면 이상탐지 CSV 의 최신 날짜를 '오늘'로 사용 (현재 2026-04-30)
TODAY_OVERRIDE=
