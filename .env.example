# 이 파일은 '양식'입니다. 실제 값은 .env 에만 넣으세요(.env 는 git 에 안 올라감).
# 복사: cp .env.example .env  → .env 를 채워서 사용

# ── 데이터 수집(아리수) ──────────────────────────────────────────
ARISU_USER_ID=
ARISU_USER_PWD=

# ── 에이전트(OpenAI GPT) ─────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna

# ── 이상 알림 메일(Gmail SMTP) ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=      # 발송 계정(앱 비밀번호 발급한 그 계정)
SMTP_PASS=   # Gmail '앱 비밀번호' (일반 비번 아님)
ALERT_FROM=     # 보통 SMTP_USER 와 동일
# 수신자는 등록된 사업소 담당자 이메일로 결정됩니다.

# ── 데모 기준일(선택) ────────────────────────────────────────────
# 비우면 저장된 위험도 분석의 최신 기준일을 사용합니다.
TODAY_OVERRIDE=

# 앱 로그인/운영 설정 — 기존 비밀값은 보존함
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=총괄 관리자
APP_ENV=development
APP_COOKIE_SECURE=false
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8000,http://localhost:8000
APP_ALLOWED_HOSTS=127.0.0.1,localhost
SESSION_HOURS=8
# 선택: 비우면 data/runtime/ 과 그 안의 app.sqlite3 를 씁니다. API와 수집 명령은 같은 값을 써야 합니다.
# APP_DATA_DIR=
# APP_DB_PATH=
# 선택: false 로 두면 이 서버는 자동·수동 수집을 실행하지 않습니다(화면 확인용).
# COLLECTION_WORKER_ENABLED=true
SEOUL_PSGR_KEY=

# ── NCP Object Storage(S3 호환) 보관 ─────────────────────────────────
# true 로 두면 수집·모델 갱신 뒤 바뀐 파일을 버킷에 복사하고, 자동 수집이 끝난 날 운영 DB 백업을 올립니다.
# 운영 DB는 로컬 SQLite 를 그대로 쓰고, 버킷에는 백업 파일만 둡니다. 값은 NCP 콘솔(마이페이지 > 인증키 관리)에서 발급합니다.
OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=https://kr.object.ncloudstorage.com
OBJECT_STORAGE_REGION=kr-standard
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# 버킷 안에서 이 서비스 파일을 모아 두는 접두어(폴더). 비우면 버킷 루트.
OBJECT_STORAGE_PREFIX=mulsaemi
# 선택: path(기본) 또는 virtual. 보관할 DB 백업 개수(0이면 정리하지 않음).
# OBJECT_STORAGE_ADDRESSING=path
# OBJECT_STORAGE_DB_BACKUP_KEEP=30
